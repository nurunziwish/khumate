# 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤 값을 채우세요.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=여기에_anon_public_키
PORT=3000
# 아이디를 '아이디@이 도메인' 으로 바꿔 쓰는 내부용 값 (실제 메일은 안 보냄). 보통 그대로 두면 됩니다.
LOGIN_EMAIL_DOMAIN=khumate.app

# ---- (선택) AI 분석 설정. 비워 두면 규칙 점수만 보여요. ----
CHATBOT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CHATBOT_API_KEY=
CHATBOT_MODEL=
